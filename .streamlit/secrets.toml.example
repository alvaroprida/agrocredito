# ─────────────────────────────────────────────────────────────────────────────
# PLANTILLA DE SECRETOS · AgroCredito
#
# 1. Copia este archivo como  .streamlit/secrets.toml  (mismo directorio).
# 2. Rellena los valores con TUS credenciales.
# 3. NUNCA subas secrets.toml a GitHub (ya está en .gitignore).
# 4. En Streamlit Community Cloud: pega este contenido en
#    "Manage app" → "Settings" → "Secrets".
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos PostGIS (Supabase) ─────────────────────────────────────────
# Cadena de conexión de tu proyecto Supabase (Project Settings → Database →
# Connection string → URI). Necesaria si USE_REAL_DB = True.
DATABASE_URL = "postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres"

# ── Google Earth Engine (NDVI · Sentinel-2) ──────────────────────────────────
[gee]
# ID de tu proyecto de Google Cloud con la Earth Engine API habilitada.
project = "tu-proyecto-gcp"

# Contenido COMPLETO del JSON de la cuenta de servicio (entre comillas triples).
# Google Cloud → IAM → Cuentas de servicio → Claves → Añadir clave (JSON).
service_account_json = """
{
  "type": "service_account",
  "project_id": "tu-proyecto-gcp",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "tu-cuenta@tu-proyecto-gcp.iam.gserviceaccount.com",
  "client_id": "...",
  "token_uri": "https://oauth2.googleapis.com/token"
}
"""
